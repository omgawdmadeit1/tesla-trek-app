{
  "appId": "com.lvlltd.teslatrek",
  "appName": "Tesla Trek",
  "webDir": "native-shell",
  "backgroundColor": "#050510",
  "ios": {
    "contentInset": "automatic",
    "preferredContentMode": "mobile",
    "scheme": "TeslaTrek",
    "backgroundColor": "#050510",
    "allowsLinkPreview": false,
    "scrollEnabled": true
  },
  "server": {
    "cleartext": false,
    "allowNavigation": [
      "tesla-trek.com",
      "www.tesla-trek.com",
      "*.tesla-trek.com",
      "*.vercel.app",
      "auth.tesla.com",
      "fleet-api.prd.na.vn.cloud.tesla.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "backgroundColor": "#050510",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#050510"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    }
  }
}
