{
  "appId": "app.tr3k.ios",
  "appName": "Tr3k",
  "webDir": "dist",
  "backgroundColor": "#14110e",
  "ios": {
    "contentInset": "automatic",
    "preferredContentMode": "mobile",
    "scheme": "Tr3k",
    "backgroundColor": "#14110e",
    "allowsLinkPreview": false,
    "scrollEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 500,
      "launchAutoHide": true,
      "backgroundColor": "#14110e",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#14110e"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    }
  },
  "server": {
    "url": "https://tr3k.app/play/",
    "allowNavigation": [
      "tr3k.app",
      "*.tile.openstreetmap.org",
      "router.project-osrm.org",
      "unpkg.com"
    ]
  }
}
