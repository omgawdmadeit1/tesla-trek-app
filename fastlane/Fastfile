require "fileutils"
require "securerandom"
require "shellwords"
require "tmpdir"

opt_out_usage

default_platform(:ios)

platform :ios do
  desc "Archive Tr3k and upload it to TestFlight using the App Store Connect API key"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      duration: 1200,
      in_house: false
    )

    team_id = "DQA38RTNF7"
    app_identifier = "app.tr3k.ios"
    profile_name = "tr3k-appstore"
    keychain_name = "tr3k-signing"
    keychain_password = ENV["KEYCHAIN_PASSWORD"].to_s
    keychain_password = SecureRandom.hex(24) if keychain_password.empty?
    build_number = ENV.fetch("BUILD_NUMBER")
    UI.user_error!("BUILD_NUMBER must be a number") unless build_number.match?(/\A\d+\z/)
    UI.user_error!("BUILD_NUMBER must be greater than 20022") unless build_number.to_i > 20022

    xcode_version = sh("xcodebuild", "-version", log: true)
    duo_sdk = false
    if xcode_version =~ /Xcode (\d+)\.(\d+)/
      major = Regexp.last_match(1).to_i
      minor = Regexp.last_match(2).to_i
      duo_sdk = major > 27 || (major == 27 && minor >= 1)
    end
    unless duo_sdk || ENV["TR3K_ALLOW_OLDER_XCODE"] == "1"
      UI.user_error!(
        "iPhone Duo upload needs Xcode 27.1 or newer (iOS 27.1 SDK).\n" \
        "#{xcode_version}\n" \
        "scripts/select-xcode.sh selects it when it is installed. " \
        "Archive steps: docs/iphone-duo.md. " \
        "TR3K_ALLOW_OLDER_XCODE=1 archives without the Duo SDK and must not be submitted for the Duo badge."
      )
    end
    if !duo_sdk && ENV["TR3K_ALLOW_OLDER_XCODE"] == "1"
      UI.important("TR3K_ALLOW_OLDER_XCODE=1: this archive is not an iPhone Duo build.")
    end

    signing_dir = File.join(ENV.fetch("RUNNER_TEMP", Dir.tmpdir), "tr3k-signing")
    FileUtils.mkdir_p(signing_dir)
    keychain_path = nil

    begin
      keychain_path = prepare_signing_keychain(
        name: keychain_name,
        password: keychain_password,
        signing_dir: signing_dir
      )

      # The App Store Connect record already exists. Register the bundle id
      # on the developer portal when sigh would otherwise miss it.
      # Associated Domains, App Groups, and Sign in with Apple have to be on
      # the App ID before sigh, or those entitlements are missing from the profile.
      app_group = "group.app.tr3k.ios"
      ensure_bundle_id(
        app_identifier: app_identifier,
        associated_domains: true,
        app_group: app_group,
        sign_in_with_apple: true
      )
      live_activity_id = "app.tr3k.ios.LiveActivity"
      ensure_bundle_id(app_identifier: live_activity_id, name: "Tr3k Live Activity")
      widget_id = "app.tr3k.ios.widget"
      ensure_bundle_id(app_identifier: widget_id, name: "Tr3k Widget", app_group: app_group)

      install_distribution_certificate(
        api_key: api_key,
        team_id: team_id,
        keychain_path: keychain_path,
        keychain_password: keychain_password,
        signing_dir: signing_dir
      )

      cert_id = lane_context[SharedValues::CERT_CERTIFICATE_ID] || ENV["CER_CERTIFICATE_ID"]
      UI.user_error!("cert did not return a certificate id") if cert_id.to_s.empty?

      identity_dump = sh("security", "find-identity", "-v", "-p", "codesigning", keychain_path, log: false)
      distribution_identity = identity_dump[/"(Apple Distribution:[^"]+)"/, 1]
      UI.user_error!("The distribution certificate is not in the temporary keychain") if distribution_identity.to_s.empty?

      # Omit development and adhoc. Passing false still counts as setting
      # both options, and sigh rejects that pair. Defaults are the App Store profile.
      sigh(
        api_key: api_key,
        app_identifier: app_identifier,
        team_id: team_id,
        platform: "ios",
        force: true,
        cert_id: cert_id,
        provisioning_name: profile_name,
        ignore_profiles_with_different_name: true,
        output_path: signing_dir,
        filename: "tr3k-appstore.mobileprovision"
      )

      # sigh appends a timestamp when the requested name is taken, and that
      # value contains a space. Pass the profile UUID, which is one token.
      profile_uuid = lane_context[SharedValues::SIGH_UUID] || ENV["SIGH_UUID"]
      UI.user_error!("sigh did not return a profile UUID") if profile_uuid.to_s.empty?
      UI.user_error!("Profile UUID must not contain spaces") if profile_uuid.match?(/\s/)

      sigh(
        api_key: api_key,
        app_identifier: live_activity_id,
        team_id: team_id,
        platform: "ios",
        force: true,
        cert_id: cert_id,
        provisioning_name: "tr3k-liveactivity-appstore",
        ignore_profiles_with_different_name: true,
        output_path: signing_dir,
        filename: "tr3k-liveactivity.mobileprovision"
      )
      live_profile_uuid = lane_context[SharedValues::SIGH_UUID]
      UI.user_error!("sigh did not return a Live Activity profile UUID") if live_profile_uuid.to_s.empty?
      UI.user_error!("Live Activity profile UUID must not contain spaces") if live_profile_uuid.match?(/\s/)

      sigh(
        api_key: api_key,
        app_identifier: widget_id,
        team_id: team_id,
        platform: "ios",
        force: true,
        cert_id: cert_id,
        provisioning_name: "tr3k-widget-appstore",
        ignore_profiles_with_different_name: true,
        output_path: signing_dir,
        filename: "tr3k-widget.mobileprovision"
      )
      widget_profile_uuid = lane_context[SharedValues::SIGH_UUID]
      UI.user_error!("sigh did not return a widget profile UUID") if widget_profile_uuid.to_s.empty?
      UI.user_error!("Widget profile UUID must not contain spaces") if widget_profile_uuid.match?(/\s/)

      update_code_signing_settings(
        use_automatic_signing: false,
        path: "ios/App/App.xcodeproj",
        team_id: team_id,
        bundle_identifier: app_identifier,
        code_sign_identity: distribution_identity,
        profile_name: profile_uuid,
        targets: ["App"]
      )
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "ios/App/App.xcodeproj",
        team_id: team_id,
        bundle_identifier: live_activity_id,
        code_sign_identity: distribution_identity,
        profile_name: live_profile_uuid,
        targets: ["Tr3kLiveActivity"]
      )
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "ios/App/App.xcodeproj",
        team_id: team_id,
        bundle_identifier: widget_id,
        code_sign_identity: distribution_identity,
        profile_name: widget_profile_uuid,
        targets: ["Tr3kWidget"]
      )

      build_app(
        project: "ios/App/App.xcodeproj",
        scheme: "App",
        configuration: "Release",
        clean: true,
        export_method: "app-store",
        export_team_id: team_id,
        output_directory: signing_dir,
        output_name: "Tr3k.ipa",
        codesigning_identity: distribution_identity,
        # Do not set PRODUCT_BUNDLE_IDENTIFIER or PROVISIONING_PROFILE_SPECIFIER
        # here. Those xcargs apply to every target, including the Live Activity
        # and widget extensions, which have their own bundle ids and profiles.
        xcargs: begin
          flags = [
            "DEVELOPMENT_TEAM=#{team_id}",
            "CURRENT_PROJECT_VERSION=#{build_number}",
            "MARKETING_VERSION=1.0.1",
            "CODE_SIGN_STYLE=Manual"
          ]
          flags << "SWIFT_ACTIVE_COMPILATION_CONDITIONS=TR3K_DUO_SDK" if duo_sdk
          flags.join(" ")
        end,
        export_options: {
          method: "app-store",
          teamID: team_id,
          signingStyle: "manual",
          signingCertificate: distribution_identity,
          provisioningProfiles: {
            app_identifier => profile_uuid,
            live_activity_id => live_profile_uuid,
            widget_id => widget_profile_uuid
          }
        }
      )

      ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH]
      UI.user_error!("The archive did not produce an ipa") if ipa_path.to_s.empty? || !File.exist?(ipa_path)

      app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_filepath: ENV.fetch("ASC_KEY_PATH"),
        duration: 1200,
        in_house: false
      )

      upload_to_testflight(
        api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
        app_identifier: app_identifier,
        apple_id: "6824752752",
        ipa: ipa_path,
        skip_waiting_for_build_processing: true,
        skip_submission: true,
        uses_non_exempt_encryption: false
      )

      UI.success("Uploaded Tr3k build #{build_number} to TestFlight")
    ensure
      begin
        delete_keychain(name: keychain_name) if keychain_path && File.exist?(keychain_path)
      rescue StandardError
        UI.important("Temporary keychain was left for the runner to discard.")
      end
    end
  end

  private_lane :prepare_signing_keychain do |options|
    create_keychain(
      name: options[:name],
      password: options[:password],
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
      add_to_search_list: true
    )

    base = File.expand_path("~/Library/Keychains/#{options[:name]}")
    keychain_path = ["#{base}-db", base].find { |candidate| File.exist?(candidate) }
    UI.user_error!("Temporary keychain was not created") if keychain_path.nil?

    sh("security", "list-keychains", "-d", "user", "-s", keychain_path)
    sh("security", "default-keychain", "-s", keychain_path)

    wwdr = File.join(options[:signing_dir], "AppleWWDRCAG3.cer")
    sh("curl", "-fsSL", "-o", wwdr, "https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer")
    sh("security", "import", wwdr, "-k", keychain_path, "-T", "/usr/bin/codesign", "-T", "/usr/bin/security")

    keychain_path
  end

  private_lane :ensure_bundle_id do |options|
    identifier = options[:app_identifier]
    display_name = options[:name] || "Tr3k"
    existing = Spaceship::ConnectAPI::BundleId.find(identifier)
    bundle = existing
    if bundle
      UI.message("Bundle id #{identifier} is already registered.")
    else
      bundle = Spaceship::ConnectAPI::BundleId.create(
        name: display_name,
        platform: "IOS",
        identifier: identifier
      )
      UI.success("Registered bundle id #{identifier}.")
    end

    if options[:associated_domains]
      ensure_capability(
        bundle: bundle,
        type: Spaceship::ConnectAPI::BundleIdCapability::Type::ASSOCIATED_DOMAINS,
        hint: "Enable Associated Domains on #{identifier} for team DQA38RTNF7."
      )
    end

    if options[:app_group]
      group = options[:app_group]
      ensure_capability(
        bundle: bundle,
        type: Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS,
        settings: [{
          key: "APP_GROUPS",
          options: [{ key: group }]
        }],
        hint: "Create the App Group #{group} (name Tr3k) and assign it to #{identifier} on team DQA38RTNF7."
      )
    end

    if options[:sign_in_with_apple]
      ensure_capability(
        bundle: bundle,
        type: Spaceship::ConnectAPI::BundleIdCapability::Type::APPLE_ID_AUTH,
        settings: [{
          key: "APPLE_ID_AUTH_APP_CONSENT",
          options: [{ key: "PRIMARY_APP_CONSENT" }]
        }],
        hint: "Enable Sign in with Apple on the App ID #{identifier} for team DQA38RTNF7. App Store Connect app 6824752752."
      )
    end
  end

  # Turns a capability on before sigh so the profile contains the entitlement.
  # Settings are tried first (the App Group id, or Sign in with Apple consent).
  # If Apple rejects the settings shape, the capability is still enabled and
  # the hint says which portal toggle Joseph has to confirm.
  private_lane :ensure_capability do |options|
    bundle = options[:bundle]
    type = options[:type]
    settings = options[:settings] || []
    hint = options[:hint].to_s
    identifier = bundle.identifier

    begin
      capabilities = bundle.get_capabilities
    rescue StandardError => error
      UI.user_error!("Could not read capabilities for #{identifier}: #{error.message}. #{hint}")
    end

    already = capabilities.any? { |cap| cap.is_type?(type) }
    begin
      if already
        unless settings.empty?
          bundle.update_capability(type, enabled: true, settings: settings)
        end
        UI.message("#{type} is enabled for #{identifier}.")
      else
        bundle.create_capability(type, settings: settings)
        UI.success("Enabled #{type} for #{identifier}.")
      end
    rescue StandardError => error
      if settings.empty?
        UI.user_error!("Could not enable #{type} for #{identifier}: #{error.message}. #{hint}")
      else
        UI.important("#{type} settings were not accepted for #{identifier}: #{error.message}")
        UI.important(hint) unless hint.empty?
        if already
          UI.important("#{type} stays enabled for #{identifier}. Confirm the portal setting.")
        else
          begin
            bundle.create_capability(type)
            UI.important("Enabled #{type} for #{identifier} without extra settings. #{hint}")
          rescue StandardError => retry_error
            UI.user_error!("Could not enable #{type} for #{identifier}: #{retry_error.message}. #{hint}")
          end
        end
      end
    end
  end

  private_lane :install_distribution_certificate do |options|
    attempts = 0
    begin
      attempts += 1
      cert(
        api_key: options[:api_key],
        team_id: options[:team_id],
        development: false,
        generate_apple_certs: true,
        force: false,
        keychain_path: options[:keychain_path],
        keychain_password: options[:keychain_password],
        output_path: options[:signing_dir],
        platform: "ios"
      )
    rescue StandardError => error
      reached_limit = error.message.to_s.include?("maximum number of available")
      raise unless attempts == 1 && reached_limit

      revoked = revoke_one_distribution_certificate
      UI.important("Revoked distribution certificate #{revoked}. Its private key is not on this runner, so it could not sign the build.")
      retry
    end

    sh(
      "security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k #{options[:keychain_password].shellescape} #{options[:keychain_path].shellescape}",
      log: false
    )
  end

  private_lane :revoke_one_distribution_certificate do
    certificates = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: "DISTRIBUTION" })
    UI.user_error!("No distribution certificate is available to replace.") if certificates.empty?

    # The newest certificate is the one a previous runner created and then
    # discarded with its keychain. Older certificates stay in place.
    target = certificates.max_by { |certificate| certificate.expiration_date.to_s }
    certificate_id = target.id
    target.delete!
    certificate_id
  end
end
